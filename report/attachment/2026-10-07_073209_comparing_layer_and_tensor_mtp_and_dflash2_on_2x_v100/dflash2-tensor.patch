+struct ggml_backend_meta_top_k_plan {
+    struct device_plan {
+        ggml_backend_t backend;
+        ggml_context_ptr ctx;
+        ggml_backend_buffer_ptr buffer;
+        ggml_cgraph * local = nullptr;
+        ggml_cgraph * merge = nullptr;
+        ggml_tensor * local_ids = nullptr;
+        ggml_tensor * local_values = nullptr;
+        ggml_tensor * ids = nullptr;
+        ggml_tensor * values = nullptr;
+        std::vector<ggml_tensor *> received_ids;
+        std::vector<ggml_tensor *> received_values;
+        ggml_backend_event_t consumed = nullptr;
+    };
+    std::vector<device_plan> devices;
+    bool has_run = false;
+
+    ~ggml_backend_meta_top_k_plan() {
+        for (auto & d : devices) {
+            ggml_backend_event_free(d.consumed);
+        }
+    }
+
+    ggml_backend_meta_top_k_plan(const ggml_tensor * top_k, const std::vector<ggml_backend_t> & backends) {
+        const size_t n = backends.size();
+        const ggml_tensor * input = top_k->src[0];
+        const auto ss = ggml_backend_meta_get_split_state(input, true);
+        const int64_t k = top_k->ne[0];
+        const int64_t rows = input->ne[1];
+        std::vector<std::vector<int32_t>> id_maps(n);
+        int64_t global_id = 0;
+        for (size_t s = 0; s < ss.n_segments; s++) {
+            for (uint32_t r = 0; r < ss.nr[s]; r++) {
+                for (size_t j = 0; j < n; j++) {
+                    for (int64_t q = 0; q < ss.ne[s*n + j]; q++) {
+                        id_maps[j].push_back(global_id++);
+                    }
+                }
+            }
+        }
+        GGML_ASSERT(global_id == input->ne[0]);
+        devices.resize(n);
+        for (size_t j = 0; j < n; j++) {
+            auto & d = devices[j];
+            d.backend = backends[j];
+            const size_t graph_size = 64 + 8*n;
+            d.ctx.reset(ggml_init({graph_size*ggml_tensor_overhead() + 2*ggml_graph_overhead_custom(graph_size, false), nullptr, true}));
+            ggml_context * ctx = d.ctx.get();
+            d.local = ggml_new_graph_custom(ctx, graph_size, false);
+            d.merge = ggml_new_graph_custom(ctx, graph_size, false);
+            ggml_tensor * map = nullptr;
+            const int64_t local_vocab = id_maps[j].size();
+            if (local_vocab > 0) {
+                const ggml_tensor * shard = ggml_backend_meta_buffer_simple_tensor(input, j);
+                GGML_ASSERT(shard->ne[0] == local_vocab);
+                ggml_tensor * logits = ggml_dup_tensor(ctx, shard);
+                logits->data = shard->data;
+                logits->buffer = shard->buffer;
+                const int64_t local_k = std::min(k, local_vocab);
+                ggml_tensor * local_ids = ggml_top_k(ctx, logits, local_k);
+                d.local_values = ggml_reshape_2d(ctx, ggml_get_rows(ctx,
+                    ggml_reshape_3d(ctx, logits, 1, local_vocab, rows), local_ids), local_k, rows);
+                map = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 1, local_vocab);
+                d.local_ids = ggml_reshape_2d(ctx, ggml_get_rows(ctx, map,
+                    ggml_reshape_1d(ctx, local_ids, local_k*rows)), local_k, rows);
+                ggml_build_forward_expand(d.local, d.local_values);
+                ggml_build_forward_expand(d.local, d.local_ids);
+            }
+
+            d.received_ids.resize(n, nullptr);
+            d.received_values.resize(n, nullptr);
+            ggml_tensor * ids = nullptr;
+            ggml_tensor * values = nullptr;
+            for (size_t q = 0; q < n; q++) {
+                const int64_t local_k = std::min(k, (int64_t) id_maps[q].size());
+                if (local_k == 0) {
+                    continue;
+                }
+                auto * vi = d.received_values[q] = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, local_k, rows);
+                auto * ii = d.received_ids[q] = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, local_k, rows);
+                values = values ? ggml_concat(ctx, values, vi, 0) : vi;
+                ids = ids ? ggml_concat(ctx, ids, ii, 0) : ii;
+            }
+            GGML_ASSERT(values && values->ne[0] >= k);
+            const int64_t candidates = values->ne[0];
+            ggml_tensor * order = ggml_argsort(ctx, values, GGML_SORT_ORDER_DESC);
+            order = ggml_cont(ctx, ggml_view_2d(ctx, order, k, rows, order->nb[1], 0));
+            d.ids = ggml_reshape_2d(ctx, ggml_get_rows(ctx, ggml_reshape_3d(ctx, ids, 1, candidates, rows), order), k, rows);
+            d.values = ggml_get_rows(ctx, ggml_reshape_3d(ctx, values, 1, candidates, rows), order);
+            ggml_build_forward_expand(d.merge, d.ids);
+            ggml_build_forward_expand(d.merge, d.values);
+            d.local->uid = ggml_graph_next_uid();
+            d.merge->uid = ggml_graph_next_uid();
+            for (ggml_cgraph * graph : {d.local, d.merge}) {
+                for (int i = 0; i < graph->n_nodes; i++) {
+                    GGML_ASSERT(ggml_backend_supports_op(d.backend, graph->nodes[i]));
+                }
+            }
+            d.buffer.reset(ggml_backend_alloc_ctx_tensors(ctx, d.backend));
+            GGML_ASSERT(d.buffer);
+            if (map) {
+                ggml_backend_tensor_set(map, id_maps[j].data(), 0, id_maps[j].size()*sizeof(int32_t));
+            }
+            d.consumed = ggml_backend_event_new(ggml_backend_get_device(d.backend));
+        }
+    }
+
+    ggml_status compute(const std::vector<ggml_tensor *> & outputs) {
+        // Wait for the previous merge before another device overwrites its receive buffers.
+        if (has_run) {
+            for (auto & dst : devices) {
+                if (!dst.consumed) {
+                    ggml_backend_synchronize(dst.backend);
+                }
+            }
+            for (auto & src : devices) {
+                for (auto & dst : devices) {
+                    if (dst.consumed && src.backend != dst.backend) {
+                        if (src.backend->iface.event_wait && ggml_backend_dev_backend_reg(ggml_backend_get_device(src.backend)) ==
+                                ggml_backend_dev_backend_reg(ggml_backend_get_device(dst.backend))) {
+                            ggml_backend_event_wait(src.backend, dst.consumed);
+                        } else {
+                            ggml_backend_event_synchronize(dst.consumed);
+                        }
+                    }
+                }
+            }
+        }
+        for (auto & d : devices) {
+            if (d.local->n_nodes) {
+                const auto status = ggml_backend_graph_compute_async(d.backend, d.local);
+                if (status != GGML_STATUS_SUCCESS) {
+                    return status;
+                }
+            }
+        }
+        for (size_t j = 0; j < devices.size(); j++) {
+            auto & src = devices[j];
+            if (!src.local_ids) {
+                continue;
+            }
+            for (auto & dst : devices) {
+                ggml_backend_tensor_copy_async(src.backend, dst.backend, src.local_ids, dst.received_ids[j]);
+                ggml_backend_tensor_copy_async(src.backend, dst.backend, src.local_values, dst.received_values[j]);
+            }
+        }
+        for (size_t j = 0; j < devices.size(); j++) {
+            auto & d = devices[j];
+            const auto status = ggml_backend_graph_compute_async(d.backend, d.merge);
+            if (status != GGML_STATUS_SUCCESS) {
+                return status;
+            }
+            ggml_backend_tensor_copy_async(d.backend, d.backend, d.ids, outputs[j]);
+            if (d.consumed) {
+                ggml_backend_event_record(d.consumed, d.backend);
+            }
+        }
+        has_run = true;
+        return GGML_STATUS_SUCCESS;
+    }
+};
