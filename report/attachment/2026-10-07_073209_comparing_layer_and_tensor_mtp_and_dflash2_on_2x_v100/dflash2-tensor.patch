+static const ggml_tensor * ggml_backend_meta_top_k_values(const ggml_tensor * tensor) {
+    if (tensor->op != GGML_OP_GET_ROWS) {
+        return nullptr;
+    }
+    const ggml_tensor * rows = tensor->src[0];
+    const ggml_tensor * ids = tensor->src[1];
+    if (ids->op != GGML_OP_TOP_K || rows->op != GGML_OP_RESHAPE || rows->src[0] != ids->src[0]) {
+        return nullptr;
+    }
+    const ggml_tensor * logits = ids->src[0];
+    if (logits->type != GGML_TYPE_F32 || !ggml_is_matrix(logits) || !ggml_is_contiguous(logits) ||
+            rows->ne[0] != 1 || rows->ne[1] != logits->ne[0] || rows->ne[2] != logits->ne[1] || rows->ne[3] != 1) {
+        return nullptr;
+    }
+    return ids;
+}
